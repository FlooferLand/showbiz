set faz cupcake
set faz chica

# Head Movements

faz 30 {
    flow 1
    rotate "jaw" x:-15
}

faz 59 {
    flow 0.5
    rotate "head" y:-45
}

faz 60 {
    flow 0.5
    rotate "head" y:45
}

faz 61 {
    flow 1
    rotate "head" x:15
}

# Eye Movements

faz 31 {
    flow 0.5
    move "leftpupil" x:-0.5
    move "rightpupil" x:-0.5
}

faz 32 {
    flow 0.5
    move "leftpupil" x:0.5
    move "rightpupil" x:0.5
}

faz 64 {
    flow 1.2
    rotate "rightuppereyelid" x:-15
    rotate "rightlowereyelid" x:25
}

faz 65 {
    flow 1.2
    rotate "leftuppereyelid" x:-15
    rotate "leftlowereyelid" x:25
}


# Body Movements

faz 56 {
    flow 0.35
    rotate "spine" x:-15
}

faz 58 {
    flow 0.35
    rotate "spine" y:-15
}

faz 57 {
    flow 0.35
    rotate "spine" y:15
}

# Arm Left

faz 26 {
    flow 0.5
    rotate "leftforearm2" y:35
}

faz 25 {
    flow 0.5
    rotate "leftarm2" y:15
}


# Arm Right

faz 67 {
    flow 0.25
    rotate "rightarm" z:70
}

faz 66 {
    flow 0.5
    rotate "rightarm2" y:30
}

faz 69 {
    flow 0.5
    rotate "rightforearm2" z:-80
}

faz 68 {
    flow 0.35
    rotate "rightforearm" x:80
}

faz 71 {
    flow 1
    rotate "righthand2" z:35
}

faz 70 {
    flow 0.5
    rotate "righthand" x:-90
}

# Cupcake Movements

faz 27 {
    flow 1.0
    rotate "cupcake" y:60
} 

faz 72 {
    flow 0.5
    move "irisright" z:-0.4
    move "irisleft" z:-0.4
}

faz 73 {
    flow 0.5
    move "irisright" z:0.4
    move "irisleft" z:0.4
}

faz 74 {
    flow 1.2
    move "eyelidright" y:1
}

faz 75 {
    flow 1.2
    move "eyelidleft" y:1
}
