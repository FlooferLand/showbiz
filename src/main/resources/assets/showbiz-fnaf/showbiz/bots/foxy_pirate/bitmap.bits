set faz bonnie

# Head Movements

faz 33 {
    flow 1
    rotate "jaw" x:-15
}

faz 34 {
    flow 1
    rotate "head" x:15
}

faz 51 {
    flow 0.5
    rotate "head" y:-45
}

faz 52 {
    flow 0.5
    rotate "head" y:45
}

# Eye Movements

faz 35 {
    flow 0.5
    move "leftpupil" x:-0.5
    move "rightpupil" x:-0.5
}

faz 36 {
    flow 0.5
    move "leftpupil" x:0.5
    move "rightpupil" x:0.5
}

faz 37 {
    flow 1.2
    rotate "rightuppereyelid" x:-20
    rotate "rightlowereyelid" x:30
}

faz 38 {
    flow 1.2
    rotate "leftuppereyelid" x:-20
    rotate "leftlowereyelid" x:30
}



# Body Movements
faz 55 { 
    flow 0.35
    rotate "spine" x:-15
}

faz 54 {  
    flow 0.35
    rotate "spine" y:-15
}

faz 53 {
    flow 0.35
    rotate "spine" y:15
}


