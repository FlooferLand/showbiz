set rae beach_bear

rae 165 {
    rotate "Upper Body" x:10
}

# Face
rae 166 {
    rotate "Jaw" x:-30
    rotate "Snout" x:8
}

# Head
rae 156 {
    rotate "Head" y:25
}
rae 157 {
    rotate "Head" y:-25
}
rae 158 {
    rotate "Head" x:20
}

# Eyes
rae 151 {
    move "Left Eyelid" y:0.5
}
rae 152 {
    move "Right Eyelid" y:0.5
}
rae 153 {
    move "Left Eye" x:-0.5
    move "Right Eye" x:0.5
}

# Arms
rae 161 {
    rotate "Right Arm" z:60
}
rae 162 {
    rotate "Right Arm" y:-65
}
rae 164 {
    rotate "Right Hand" y:-50
}
rae 163 {  # Guitar strum
    rotate "Right Lower Arm" z:45
    rotate "Right Hand" z:10
}
rae 155 {
    rotate "Guitar" z:-17
    rotate "Left Arm" x:7
    rotate "Left Lower Arm" x:25
    rotate "Left Hand" x:-25
}
rae 154 {
    rotate "Left Lower Arm" y:-25
}

# Legs
rae 160 {
    rotate "Right Leg" x:18
    rotate "Right Lower Leg" x:24
    rotate "Right Foot" x:10
}
rae 159 {
    rotate "Left Leg" x:18
    rotate "Left Lower Leg" x:24
    rotate "Left Foot" x:10
}
