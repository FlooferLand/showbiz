set rae looney_bird

rae 171 {
    flow speed in:2.0 out:2.0
    flow accel in:0.18 out:0.16
    flow smash in:0.0 out:0.0
    rotate "head" y:-78
    wigglemul 2.0
}

rae 167 {
    flow speed in:2.0 out:2.0
    flow accel in:0.6 out:0.6
    flow smash in:0.0 out:0.0
    rotate "mouth" x:-25
}

rae 172 {
    flow speed in:0.8 out:0.95
    flow accel in:0.12 out:0.11
    flow smash in:0.0 out:0.0
    move "looney" y:11
    wigglemul 2.0
}

rae 191 {
    flow speed in:2.0 out:2.0
    flow accel in:0.5 out:0.5
    flow smash in:0.0 out:0.0
    move "eyelid_l" y:-2
}

rae 192 {
    flow speed in:2.0 out:2.0
    flow accel in:0.5 out:0.5
    flow smash in:0.0 out:0.0
    move "eyelid_r" y:-2
}

rae 193 {
    flow speed in:2.0 out:2.0
