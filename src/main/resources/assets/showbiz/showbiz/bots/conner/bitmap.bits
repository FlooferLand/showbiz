# Conner The Cow is a quite silly bot from an old FNaF fangame I'm working on
# It's hidden from the bot selection screen and we mainly use it for testing new things
# It also serves as a little easter egg
# - Floof

set faz bonnie
set rae beach_bear

# guitar raise
faz 46, rae 155 {
    flow speed in:0.24 out:0.3
    flow accel in:1.0 out:1.0
    rotate "upper_arm_l" z:-15
}

# arm twist r
faz 43, rae 161 {
    flow speed in:0.16 out:0.2
    flow accel in:1.0 out:1.0
    rotate "upper_arm_r" z:10
}

# head turn l
faz 52, rae 156 {
    flow speed in:0.6 out:0.6
    flow accel in:1.0 out:1.0
    rotate "head" y:25
}

# head turn r
faz 51, rae 157 {
    flow speed in:0.6 out:0.6
    flow accel in:1.0 out:1.0
    rotate "head" y:-25
}

# head up
faz 34, rae 158 {
    flow speed in:0.56 out:0.7
    flow accel in:1.0 out:1.0
    rotate "head" x:15
}

# body lean
faz 55, rae 165 {
    flow speed in:0.64 out:0.8
    flow accel in:1.0 out:1.0
    anim "body_tilt"
}

# jaw
faz 33, rae 166 {
    flow speed in:1.2 out:1.5
    flow accel in:1.0 out:1.0
    rotate "jaw" x:-30
}

# eyes left
faz 36, rae 151 {
    flow speed in:0.48 out:0.6
    flow accel in:1.0 out:1.0
    move "left_eye" x:1
    move "right_eye" x:1
}

# eyes right
faz 35, rae 152 {
    flow speed in:0.48 out:0.6
    flow accel in:1.0 out:1.0
    move "left_eye" x:-1
    move "right_eye" x:-1
}
