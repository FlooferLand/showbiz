{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/scripts/.venv/bin/python",
            "cwd": "${fileDirname}",
            "windows": {
                "python": "${workspaceFolder}\\scripts\\.venv\\Scripts\\python.exe"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "revealProblems": "onProblem",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}