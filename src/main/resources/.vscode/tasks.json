{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/scripts"
    },
    "tasks": [
        {
            "label": "setup_python_venv",
            "type": "shell",
            "command": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip",
            "windows": {
                "command": "python -m venv .venv; .venv\\Scripts\\python.exe -m pip install --upgrade pip"
            },
            "problemMatcher": []
        },
        {
            "label": "setup_python_req",
            "type": "shell",
            "command": ".venv/bin/python -m pip install -r requirements.txt",
            "windows": {
                "command": ".venv\\Scripts\\python.exe -m pip install -r requirements.txt"
            },
            "problemMatcher": []
        },
        {
            "label": "setup",
            "type": "shell",
            "dependsOn": ["setup_python_venv", "setup_python_req"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        
        {
            "label": "Python: Current File",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/.venv/bin/python",
            "args": ["${file}"],
            "options": {
                "cwd": "${fileDirname}"
            },
            "windows": {
                "command": "${workspaceFolder}\\scripts\\.venv\\Scripts\\python.exe"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "revealProblems": "onProblem",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}